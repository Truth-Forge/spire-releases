            <sparkle:hardwareRequirements>arm64</sparkle:hardwareRequirements>
            <enclosure url="https://github.com/Truth-Forge/spire-releases/releases/download/v1.7.21-451/Spire-1.7.21-451.zip" length="81040630" type="application/octet-stream" sparkle:edSignature="8H5jqMKvREixdIMZDmdFpHJB5YUTGapfFk+THgUcOOPrlfnQfGOzuOw0rUQ4LIjn6arlsqCl3SwKtT8wTh+DDw==" />
        <description>&lt;h3&gt;Fixed&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;The Updates card no longer advertises the installed version as an available download. It shows Check for Updates until Sparkle finds a newer signed build, then offers Update.&lt;/li&gt;
&lt;li&gt;A completed check with no compatible update clears an earlier download offer.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Includes the installation access recovery, logging, and durable service restoration fixes from 1.7.20.&lt;/p&gt;</description></item>
